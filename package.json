{
  "name": "clip-composer",
  "version": "1.0.0",
  "type": "module",
  "description": "ShortVideo Generator - SNSショート動画を大量生成するデスクトップアプリ",
  "main": "frontend/src/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "eslint frontend/src",
    "lint:fix": "eslint frontend/src --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "video",
    "editor",
    "electron",
    "react"
  ],
  "author": "Shoei",
  "license": "MIT",
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.0",
    "autoprefixer": "^10.4.22",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.556.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "tailwindcss": "^3.4.18",
    "uuid": "^13.0.0"
  },
  "build": {
    "extends": "./electron.config.js"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-onboarding": "^10.1.4",
    "@storybook/addon-vitest": "^10.1.4",
    "@storybook/react-vite": "^10.1.4",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "concurrently": "^9.2.1",
    "electron": "^28.3.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.1.4",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "playwright": "^1.57.0",
    "prop-types": "^15.8.1",
    "storybook": "^10.1.4",
    "vite": "^7.2.6",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3"
  }
}
